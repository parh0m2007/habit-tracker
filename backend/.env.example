# Порт API
API_PORT=3001
# Путь к файлу SQLite (":memory:" — хранить только в памяти)
DB_PATH=./data/tasks.db

# --- ИИ: любой OpenAI-совместимый API (по умолчанию tooken.club) ---
# Ключ из кабинета tooken.club. Если не задан — ИИ-эндпоинт работает в режиме заглушки.
AI_API_KEY=
AI_BASE_URL=https://tooken.club/v1
AI_MODEL=deepseek-v4.1-flash-1017
# Таймаут запроса к модели, мс
AI_TIMEOUT_MS=60000
